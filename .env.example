# Provedor da LLM: anthropic (padrão) ou openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Modelo. O claude-3-5-sonnet-latest citado na spec foi aposentado pela Anthropic;
# use um modelo atual.
LLM_MODEL=claude-sonnet-5-5
LLM_MAX_TOKENS=4096

# Pipeline
MAX_JOB_AGE_DAYS=30
HTTP_TIMEOUT=15
